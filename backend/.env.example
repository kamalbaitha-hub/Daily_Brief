# Server Port
PORT=5000

# OpenAI API Key for 3-5 line AI summarization (optional: falls back to intelligent summarizer if omitted)
OPENAI_API_KEY=your_openai_api_key_here

# Optional NewsAPI key (if provided, can fetch additional articles)
NEWS_API_KEY=your_news_api_key_here

# Timezone for Cron Scheduler (defaults to 7 AM IST)
TZ=Asia/Kolkata
